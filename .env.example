# ==============================================================================
# OffPay (AirBirr) - Environment Template (.env.example)
# ==============================================================================
# Copy this file to .env and adjust values for your local environment:
#   cp .env.example .env

# ------------------------------------------------------------------------------
# 1. Environment & Runtime
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# ------------------------------------------------------------------------------
# 2. Central Bank / Backend Server (FastAPI / Uvicorn)
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# Master Bank database file path (SQLite)
OFFPAY_DB_PATH=backend/master_bank.db

# Master Bank 32-byte Ed25519 seed key file path
OFFPAY_KEY_SEED_PATH=backend/bank_master_key.seed

# ------------------------------------------------------------------------------
# 3. Client & Mobile App Connection URL (Flutter / Dart)
# ------------------------------------------------------------------------------
# Active base URL used by Flutter clients to reach the Central Bank backend.
# Run Flutter with: flutter run --dart-define-from-file=.env
# Options:
#   - ngrok / Cloud URL: https://your-subdomain.ngrok-free.dev
#   - Android Emulator:  http://10.0.2.2:8000
#   - iOS Simulator:     http://127.0.0.1:8000
#   - Physical Device:   http://<YOUR_LAN_IP>:8000 (e.g., http://192.168.1.15:8000)
OFFPAY_API_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 4. Cloud Database (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@endpoint.region.aws.neon.tech/neondb?sslmode=require"
NEON_BRANCH=production
NEON_BRANCH_ID=br-placeholder
NEON_FUNCTION_HOST_SUFFIX=.compute.region.aws.neon.tech
